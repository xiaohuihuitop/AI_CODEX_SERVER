{
  "name": "codex-desktop-client",
  "version": "0.3.15",
  "private": true,
  "type": "commonjs",
  "description": "Windows desktop client and agent for Codex bridge",
  "author": "codex-bridge contributors",
  "main": "electron/main.js",
  "scripts": {
    "start": "node desktop-agent.js",
    "start:agent": "node desktop-agent.js",
    "start:manager": "node desktop-manager-server.js",
    "start:manager:gui": "electron electron/main.js",
    "build:manager:win": "electron-builder --win dir && node scripts/verify-manager-artifact.js"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "electron": "42.3.3",
    "electron-builder": "^26.15.2"
  },
  "engines": {
    "node": ">=20"
  },
  "productName": "Codex Desktop 管理器",
  "build": {
    "appId": "io.github.codexbridge.desktop-manager",
    "productName": "Codex Desktop 管理器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "desktop-agent.js",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
